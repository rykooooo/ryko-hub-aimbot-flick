local popupTimer = 0

RunService.Stepped:Connect(function(_, dt)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")

	if MoveConfig.NoClip and char then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end

	if hum then
		if MoveConfig.WalkSpeedEnabled and (MoveConfig.WalkSpeedLoop or hum.WalkSpeed ~= MoveConfig.WalkSpeed) then
			pcall(function() hum.WalkSpeed = MoveConfig.WalkSpeed end)
		end
		if MoveConfig.JumpPowerEnabled then
			pcall(function()
				if hum.UseJumpPower then
					hum.JumpPower = MoveConfig.JumpPower
				else
					hum.JumpHeight = MoveConfig.JumpPower * 0.25
				end
			end)
		end
		if MoveConfig.AntiRagdoll then
			pcall(function()
				hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
				hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
			end)
		end
		if MoveConfig.AutoSprint and hum.MoveDirection.Magnitude > 0 and not MoveConfig.WalkSpeedEnabled then
			pcall(function() hum.WalkSpeed = math.max(hum.WalkSpeed, 22) end)
		end
	end

	if MoveConfig.Spinbot and root then
		pcall(function()
			root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(MoveConfig.SpinSpeed), 0)
		end)
	end

	if MoveConfig.Shiftlock and root and workspace.CurrentCamera then
		pcall(function()
			local look = workspace.CurrentCamera.CFrame.LookVector
			local flatLook = Vector3.new(look.X, 0, look.Z)
			if flatLook.Magnitude > 0.01 then
				root.CFrame = CFrame.lookAt(root.Position, root.Position + flatLook)
			end
		end)
	end

	if MoveConfig.FlyEnabled and root and workspace.CurrentCamera then
		pcall(function()
			local humMove = hum and hum.MoveDirection or Vector3.zero
			local camCF = workspace.CurrentCamera.CFrame
			local moveVec = Vector3.zero
			if humMove.Magnitude > 0 then
				moveVec = (camCF.LookVector * humMove.Z * -1 + camCF.RightVector * humMove.X)
				if moveVec.Magnitude > 0.01 then
					moveVec = moveVec.Unit * MoveConfig.FlySpeed * (1 / 60)
				end
			end
			root.AssemblyLinearVelocity = Vector3.zero
			root.CFrame = CFrame.new(root.Position + moveVec) * root.CFrame.Rotation
		end)
	end

	if WorldConfig.AutoSkipPopups then
		popupTimer = popupTimer + (dt or 0)
		if popupTimer >= 1.5 then
			popupTimer = 0
			pcall(function()
				local pg = LocalPlayer:FindFirstChild("PlayerGui")
				if pg then
					for _, gui in ipairs(pg:GetChildren()) do
						if gui.Name ~= "RYKO_HUB_FPS_Overlay" and gui.Name ~= "RYKO_HUB_Aimbot_Button" then
							for _, btn in ipairs(gui:GetDescendants()) do
								if btn:IsA("TextButton") and btn.Visible then
									local txt = string.lower(btn.Text)
									if txt == "x" or txt == "close" or txt == "fechar" or txt == "ok" then
										pcall(function() btn:Activate() end)
									end
								end
							end
						end
					end
				end
			end)
		end
	end
end)

