local fpsAccum = 0
local frameCount = 0

RunService.RenderStepped:Connect(function(deltaTime)
	Camera = workspace.CurrentCamera
	if not Camera then return end

	if MoveConfig.CameraFOV ~= 70 then
		pcall(function() Camera.FieldOfView = MoveConfig.CameraFOV end)
	end

	local viewportSize = Camera.ViewportSize
	local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
	local lineOrigin = (ESPConfig.LineOrigin == "Em cima")
		and Vector2.new(viewportSize.X / 2, 0)
		or Vector2.new(viewportSize.X / 2, viewportSize.Y)

	if FPSConfig.CounterVisible then
		FPSFrame.Visible = true
		fpsAccum = fpsAccum + deltaTime
		frameCount = frameCount + 1
		if fpsAccum >= 0.25 then
			local fps = math.floor((frameCount / fpsAccum) + 0.5)
			local ping = getPingMs()
			local mem = getMemoryMB()

			if FPSConfig.CompactCounter then
				FPSLabel.Text = string.format("%d FPS | %dms", fps, ping)
			else
				local parts = { "FPS: " .. tostring(fps) }
				if FPSConfig.ShowPing then
					table.insert(parts, "Ping: " .. (ping > 0 and (tostring(ping) .. "ms") or "--ms"))
				end
				if FPSConfig.ShowMemory then
					table.insert(parts, "RAM: " .. tostring(mem) .. "MB")
				end
				FPSLabel.Text = table.concat(parts, " | ")
			end

			if FPSConfig.DynamicColor then
				if fps >= 55 and (ping == 0 or ping <= 120) then
					FPSLabel.TextColor3 = Color3.fromRGB(90, 255, 140)
				elseif fps >= 30 and (ping == 0 or ping <= 220) then
					FPSLabel.TextColor3 = Color3.fromRGB(255, 220, 80)
				else
					FPSLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
				end
			else
				FPSLabel.TextColor3 = Color3.fromRGB(240, 240, 255)
			end

			fpsAccum = 0
			frameCount = 0
		end
	else
		FPSFrame.Visible = false
	end

	local effectiveFOV = AimbotConfig.FOVRadius
	if AimbotConfig.FOVDynamicZoom and Camera.FieldOfView > 0 then
		effectiveFOV = AimbotConfig.FOVRadius * (70 / Camera.FieldOfView)
	end

	local aimPos, lockedPlr = nil, nil
	if AimbotConfig.Enabled then
		aimPos, lockedPlr = getClosestTarget(screenCenter, effectiveFOV)
		if aimPos then
			local desiredCF = CFrame.lookAt(Camera.CFrame.Position, aimPos)
			Camera.CFrame = Camera.CFrame:Lerp(desiredCF, AimbotConfig.Smoothness)
		end
	end

	local showFOV = AimbotConfig.FOVEnabled and (not AimbotConfig.FOVOnlyWhenAiming or AimbotConfig.Enabled)
	if showFOV then
		setProp(FOVCircle, "Position", screenCenter)
		setProp(FOVCircle, "Radius", effectiveFOV)
		setProp(FOVCircle, "Thickness", AimbotConfig.FOVThickness)
		setProp(FOVCircle, "NumSides", AimbotConfig.FOVNumSides)
		setProp(FOVCircle, "Color", AimbotConfig.FOVColor)
		setProp(FOVCircle, "Visible", true)
	else
		setProp(FOVCircle, "Visible", false)
	end

	for player, data in pairs(ESPObjects) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local head = character and character:FindFirstChild("Head")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		local aliveOk = not ESPConfig.OnlyAlive or (humanoid and humanoid.Health > 0)
		local teamHidden = isSameTeam(player, ESPConfig.TeamCheck)

		if not (ESPConfig.MasterEnabled and character and root and head and humanoid and aliveOk and not teamHidden) then
			hideESP(data)
		else
			local distance = (Camera.CFrame.Position - root.Position).Magnitude
			if distance > ESPConfig.MaxDistance then
				hideESP(data)
			else
				local activeColor = ESPConfig.Color
				if ESPConfig.TargetIndicator and lockedPlr == player then
					activeColor = ESPConfig.TargetColor
				elseif isFriendPlayer(player) then
					activeColor = ESPConfig.FriendColor
				end

				if ESPConfig.Highlight then
					if not data.Highlight then
						local hl = Instance.new("Highlight")
						hl.Name = "RYKO_ESP_HL"
						hl.FillTransparency = 0.65
						hl.OutlineTransparency = 0.1
						hl.Adornee = character
						hl.Parent = character
						data.Highlight = hl
					end
					pcall(function()
						data.Highlight.FillColor = activeColor
						data.Highlight.OutlineColor = activeColor
						data.Highlight.Enabled = true
					end)
				else
					clearHighlight(data)
				end

				local rootPos, onScreen = Camera:WorldToViewportPoint(root.Position)

				if ESPConfig.OutOfFOVArrows and not onScreen then
					local relPos = Camera.CFrame:PointToObjectSpace(root.Position)
					local angle = math.atan2(relPos.Y, relPos.X)
					local radius = math.min(viewportSize.X, viewportSize.Y) * 0.36
					local tip = Vector2.new(screenCenter.X + math.cos(angle) * radius, screenCenter.Y - math.sin(angle) * radius)
					local leftPt = Vector2.new(tip.X - math.cos(angle - 0.5) * 14, tip.Y + math.sin(angle - 0.5) * 14)
					local rightPt = Vector2.new(tip.X - math.cos(angle + 0.5) * 14, tip.Y + math.sin(angle + 0.5) * 14)
					setProp(data.Arrow, "PointA", tip)
					setProp(data.Arrow, "PointB", leftPt)
					setProp(data.Arrow, "PointC", rightPt)
					setProp(data.Arrow, "Color", activeColor)
					setProp(data.Arrow, "Visible", true)
				else
					setProp(data.Arrow, "Visible", false)
				end

				if not onScreen then
					setProp(data.BoxOutline, "Visible", false)
					setProp(data.Box2D, "Visible", false)
					for _, l in ipairs(data.CornerLines) do setProp(l, "Visible", false) end
					for _, l in ipairs(data.Box3DLines) do setProp(l, "Visible", false) end
					setProp(data.Line, "Visible", false)
					setProp(data.HealthOutline, "Visible", false)					setProp(data.HealthBar, "Visible", false)
					setProp(data.InfoText, "Visible", false)
					setProp(data.SubText, "Visible", false)
					for _, b in ipairs(data.Skeleton) do setProp(b, "Visible", false) end
				else
					local topPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
					local bottomPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
					local boxH = math.max(math.abs(bottomPos.Y - topPos.Y), 8)
					local boxW = boxH * 0.6
					local boxX = rootPos.X - (boxW / 2)
					local boxY = topPos.Y

					if ESPConfig.Box2D then
						setProp(data.BoxOutline, "Size", Vector2.new(boxW, boxH))
						setProp(data.BoxOutline, "Position", Vector2.new(boxX, boxY))
						setProp(data.BoxOutline, "Thickness", ESPConfig.Thickness + 1.5)
						setProp(data.BoxOutline, "Visible", true)

						setProp(data.Box2D, "Size", Vector2.new(boxW, boxH))
						setProp(data.Box2D, "Position", Vector2.new(boxX, boxY))
						setProp(data.Box2D, "Thickness", ESPConfig.Thickness)
						setProp(data.Box2D, "Color", activeColor)
						setProp(data.Box2D, "Visible", true)
					else
						setProp(data.BoxOutline, "Visible", false)
						setProp(data.Box2D, "Visible", false)
					end

					if ESPConfig.CornerBox then
						local cLen = math.min(boxW, boxH) * 0.25
						local tl = Vector2.new(boxX, boxY)
						local tr = Vector2.new(boxX + boxW, boxY)
						local bl = Vector2.new(boxX, boxY + boxH)
						local br = Vector2.new(boxX + boxW, boxY + boxH)
						local segs = {
							{ tl, tl + Vector2.new(cLen, 0) }, { tl, tl + Vector2.new(0, cLen) },
							{ tr, tr - Vector2.new(cLen, 0) }, { tr, tr + Vector2.new(0, cLen) },
							{ bl, bl + Vector2.new(cLen, 0) }, { bl, bl - Vector2.new(0, cLen) },
							{ br, br - Vector2.new(cLen, 0) }, { br, br - Vector2.new(0, cLen) },
						}
						for i = 1, 8 do
							setProp(data.CornerLines[i], "From", segs[i][1])
							setProp(data.CornerLines[i], "To", segs[i][2])
							setProp(data.CornerLines[i], "Thickness", ESPConfig.Thickness)
							setProp(data.CornerLines[i], "Color", activeColor)
							setProp(data.CornerLines[i], "Visible", true)
						end
					else
						for i = 1, 8 do setProp(data.CornerLines[i], "Visible", false) end
					end

					if ESPConfig.Box3D then
						local sx, sy, sz = 2.1, 2.8, 1.4
						local cf = root.CFrame
						local pts3D = {
							cf * Vector3.new(-sx, sy, -sz), cf * Vector3.new(sx, sy, -sz),
							cf * Vector3.new(sx, sy, sz), cf * Vector3.new(-sx, sy, sz),
							cf * Vector3.new(-sx, -sy, -sz), cf * Vector3.new(sx, -sy, -sz),
							cf * Vector3.new(sx, -sy, sz), cf * Vector3.new(-sx, -sy, sz),
						}
						local pts2D = {}
						local allVis = true
						for i = 1, 8 do
							local sp, vis = Camera:WorldToViewportPoint(pts3D[i])
							if not vis then allVis = false; break end
							pts2D[i] = Vector2.new(sp.X, sp.Y)
						end
						if allVis then
							local edges = {
								{1,2},{2,3},{3,4},{4,1},
								{5,6},{6,7},{7,8},{8,5},
								{1,5},{2,6},{3,7},{4,8},
							}
							for i = 1, 12 do
								local e = edges[i]
								setProp(data.Box3DLines[i], "From", pts2D[e[1]])
								setProp(data.Box3DLines[i], "To", pts2D[e[2]])
								setProp(data.Box3DLines[i], "Thickness", ESPConfig.Thickness)
								setProp(data.Box3DLines[i], "Color", activeColor)
								setProp(data.Box3DLines[i], "Visible", true)
							end
						else
							for i = 1, 12 do setProp(data.Box3DLines[i], "Visible", false) end
						end
					else
						for i = 1, 12 do setProp(data.Box3DLines[i], "Visible", false) end
					end

					if ESPConfig.LineEnabled then
						setProp(data.Line, "From", lineOrigin)
						setProp(data.Line, "To", Vector2.new(rootPos.X, (ESPConfig.LineOrigin == "Em cima") and topPos.Y or bottomPos.Y))
						setProp(data.Line, "Thickness", ESPConfig.Thickness)
						setProp(data.Line, "Color", ESPConfig.LineColor)
						setProp(data.Line, "Visible", true)
					else
						setProp(data.Line, "Visible", false)
					end

					if ESPConfig.HealthBar then
						local ratio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
						local barX = boxX - 6
						local curTop = (boxY + boxH) - (boxH * ratio)
						setProp(data.HealthOutline, "From", Vector2.new(barX, boxY - 1))
						setProp(data.HealthOutline, "To", Vector2.new(barX, boxY + boxH + 1))
						setProp(data.HealthOutline, "Visible", true)
						setProp(data.HealthBar, "From", Vector2.new(barX, curTop))
						setProp(data.HealthBar, "To", Vector2.new(barX, boxY + boxH))
						setProp(data.HealthBar, "Color", Color3.fromRGB(255 * (1 - ratio), 255 * ratio, 60))
						setProp(data.HealthBar, "Visible", true)
					else
						setProp(data.HealthOutline, "Visible", false)
						setProp(data.HealthBar, "Visible", false)
					end

					local topParts = {}
					if ESPConfig.Name then
						table.insert(topParts, ESPConfig.UseDisplayName and player.DisplayName or player.Name)
					end
					if ESPConfig.Distance then
						table.insert(topParts, tostring(math.floor(distance)) .. "m")
					end
					if ESPConfig.HealthText then
						table.insert(topParts, tostring(math.floor(humanoid.Health)) .. "/" .. tostring(math.floor(humanoid.MaxHealth)))
					end
					if #topParts > 0 then
						setProp(data.InfoText, "Text", table.concat(topParts, " • "))
						setProp(data.InfoText, "Size", ESPConfig.TextSize)
						setProp(data.InfoText, "Position", Vector2.new(rootPos.X, boxY - (ESPConfig.TextSize + 4)))
						setProp(data.InfoText, "Color", activeColor)
						setProp(data.InfoText, "Visible", true)
					else
						setProp(data.InfoText, "Visible", false)
					end

					if ESPConfig.Tool then
						local tool = character:FindFirstChildOfClass("Tool")
						local toolName = tool and tool.Name or "Sem Item"
						setProp(data.SubText, "Text", "[" .. toolName .. "]")
						setProp(data.SubText, "Size", math.max(ESPConfig.TextSize - 1, 10))
						setProp(data.SubText, "Position", Vector2.new(rootPos.X, boxY + boxH + 4))
						setProp(data.SubText, "Visible", true)
					else
						setProp(data.SubText, "Visible", false)
					end

					if ESPConfig.Skeleton then
						local bones = (humanoid.RigType == Enum.HumanoidRigType.R15) and R15Bones or R6Bones
						for i = 1, #data.Skeleton do
							local line = data.Skeleton[i]
							local pair = bones[i]
							if pair then
								local pA = character:FindFirstChild(pair[1])
								local pB = character:FindFirstChild(pair[2])
								if pA and pB then
									local sA, vA = Camera:WorldToViewportPoint(pA.Position)
									local sB, vB = Camera:WorldToViewportPoint(pB.Position)
									if vA and vB then
										setProp(line, "From", Vector2.new(sA.X, sA.Y))
										setProp(line, "To", Vector2.new(sB.X, sB.Y))
										setProp(line, "Thickness", ESPConfig.Thickness)
										setProp(line, "Color", activeColor)
										setProp(line, "Visible", true)
									else
										setProp(line, "Visible", false)
									end
								else
									setProp(line, "Visible", false)
								end
							else
								setProp(line, "Visible", false)
							end
						end
					else
						for _, b in ipairs(data.Skeleton) do setProp(b, "Visible", false) end
					end
				end
			end
		end
	end
end)
