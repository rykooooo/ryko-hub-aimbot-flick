local function newDrawing(drawType, props)
	local ok, obj = pcall(function() return Drawing.new(drawType) end)
	if not ok or not obj then return nil end
	for k, v in pairs(props) do
		pcall(function() obj[k] = v end)
	end
	return obj
end

local function setProp(obj, prop, val)
	if obj then pcall(function() obj[prop] = val end) end
end

local function removeObj(obj)
	if obj then pcall(function() obj:Remove() end) end
end

local FOVCircle = newDrawing("Circle", {
	Thickness = AimbotConfig.FOVThickness,
	NumSides = AimbotConfig.FOVNumSides,
	Radius = AimbotConfig.FOVRadius,
	Filled = false,
	Color = AimbotConfig.FOVColor,
	Visible = false,
})

local function createESP(player)
	if player == LocalPlayer or ESPObjects[player] then return end

	local data = {
		BoxOutline = newDrawing("Square", { Thickness = 3, Filled = false, Color = Color3.new(0, 0, 0), Visible = false }),
		Box2D = newDrawing("Square", { Thickness = 1.5, Filled = false, Color = ESPConfig.Color, Visible = false }),
		CornerLines = {},
		Box3DLines = {},
		Line = newDrawing("Line", { Thickness = 1.5, Color = ESPConfig.LineColor, Visible = false }),
		HealthOutline = newDrawing("Line", { Thickness = 4, Color = Color3.new(0, 0, 0), Visible = false }),
		HealthBar = newDrawing("Line", { Thickness = 2, Color = Color3.fromRGB(0, 255, 100), Visible = false }),
		InfoText = newDrawing("Text", { Size = 14, Center = true, Outline = true, Color = ESPConfig.Color, Visible = false }),
		SubText = newDrawing("Text", { Size = 13, Center = true, Outline = true, Color = Color3.fromRGB(220, 220, 255), Visible = false }),
		Arrow = newDrawing("Triangle", { Filled = true, Thickness = 1.5, Color = ESPConfig.Color, Visible = false }),
		Skeleton = {},
		Highlight = nil,
	}

	for i = 1, 8 do
		data.CornerLines[i] = newDrawing("Line", { Thickness = 1.5, Color = ESPConfig.Color, Visible = false })
	end
	for i = 1, 12 do
		data.Box3DLines[i] = newDrawing("Line", { Thickness = 1.4, Color = ESPConfig.Color, Visible = false })
	end
	for i = 1, 14 do
		data.Skeleton[i] = newDrawing("Line", { Thickness = 1.5, Color = ESPConfig.Color, Visible = false })
	end

	ESPObjects[player] = data
end

local function clearHighlight(data)
	if data and data.Highlight then
		pcall(function() data.Highlight:Destroy() end)
		data.Highlight = nil
	end
end

local function removeESP(player)
	local data = ESPObjects[player]
	if not data then return end
	removeObj(data.BoxOutline)
	removeObj(data.Box2D)
	for _, l in ipairs(data.CornerLines) do removeObj(l) end
	for _, l in ipairs(data.Box3DLines) do removeObj(l) end
	removeObj(data.Line)
	removeObj(data.HealthOutline)
	removeObj(data.HealthBar)
	removeObj(data.InfoText)
	removeObj(data.SubText)
	removeObj(data.Arrow)
	for _, b in ipairs(data.Skeleton) do removeObj(b) end
	clearHighlight(data)
	ESPObjects[player] = nil
end

local function hideESP(data)
	setProp(data.BoxOutline, "Visible", false)
	setProp(data.Box2D, "Visible", false)
	for _, l in ipairs(data.CornerLines) do setProp(l, "Visible", false) end
	for _, l in ipairs(data.Box3DLines) do setProp(l, "Visible", false) end
	setProp(data.Line, "Visible", false)
	setProp(data.HealthOutline, "Visible", false)
	setProp(data.HealthBar, "Visible", false)
	setProp(data.InfoText, "Visible", false)
	setProp(data.SubText, "Visible", false)
	setProp(data.Arrow, "Visible", false)
	for _, b in ipairs(data.Skeleton) do setProp(b, "Visible", false) end
	clearHighlight(data)
end

local function isSameTeam(player, teamCheckEnabled)
	if not teamCheckEnabled then return false end
	if LocalPlayer.Team and player.Team then
		return LocalPlayer.Team == player.Team
	end
	return false
end

local function isFriendPlayer(player)
	if not ESPConfig.FriendHighlight then return false end
	local ok, res = pcall(function() return LocalPlayer:IsFriendsWith(player.UserId) end)
	return ok and res == true
end

local function hasLineOfSight(fromPos, targetPart, targetCharacter)
	if not AimbotConfig.WallCheck then return true end
	local ok, result = pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local ignoreList = {}
		if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
		if targetCharacter then table.insert(ignoreList, targetCharacter) end
		params.FilterDescendantsInstances = ignoreList
		local dir = targetPart.Position - fromPos
		return workspace:Raycast(fromPos, dir, params)
	end)
	if not ok then return true end
	return result == nil
end

local function getAimTargetData(character, humanoid)
	local head = character:FindFirstChild("Head")
	local root = character:FindFirstChild("HumanoidRootPart")
	local isR15 = humanoid and humanoid.RigType == Enum.HumanoidRigType.R15
	local spot = AimbotConfig.TargetSpot
	local chosenPart = nil
	local pos = nil

	if spot == "Cabeça" then
		chosenPart = head or root
		pos = chosenPart and chosenPart.Position
	elseif spot == "Pescoço" then
		if isR15 then
			local ut = character:FindFirstChild("UpperTorso")
			chosenPart = ut or head or root
			if head and ut then pos = head.Position:Lerp(ut.Position, 0.55)
			elseif head then pos = head.Position - Vector3.new(0, 0.7, 0)
			elseif root then pos = root.Position end
		else
			local t = character:FindFirstChild("Torso")
			chosenPart = t or head or root
			if head and t then pos = head.Position:Lerp(t.Position, 0.45)
			elseif head then pos = head.Position - Vector3.new(0, 0.7, 0)
			elseif root then pos = root.Position end
		end
	elseif spot == "Torso" then
		chosenPart = (isR15 and (character:FindFirstChild("UpperTorso") or character:FindFirstChild("LowerTorso")) or character:FindFirstChild("Torso")) or root
		pos = chosenPart and chosenPart.Position
	elseif spot == "Perna" then
		local list = isR15 and { "RightLowerLeg", "RightUpperLeg", "LeftLowerLeg", "LeftUpperLeg" } or { "Right Leg", "Left Leg" }
		for _, n in ipairs(list) do
			local p = character:FindFirstChild(n)
			if p then chosenPart = p; pos = p.Position; break end
		end
		if not pos and root then chosenPart = root; pos = root.Position - Vector3.new(0, 2, 0) end
	elseif spot == "Braços" then
		local list = isR15 and { "RightUpperArm", "RightLowerArm", "LeftUpperArm", "LeftLowerArm" } or { "Right Arm", "Left Arm" }
		for _, n in ipairs(list) do
			local p = character:FindFirstChild(n)
			if p then chosenPart = p; pos = p.Position; break end
		end
		if not pos and root then chosenPart = root; pos = root.Position end
	end

	if pos and chosenPart and AimbotConfig.Prediction > 0 then
		local vel = chosenPart.AssemblyLinearVelocity or Vector3.zero
		pos = pos + (vel * AimbotConfig.Prediction)
	end

	return pos, chosenPart
end

local currentLockedPlayer = nil

local function getClosestTarget(screenCenter, effectiveFOVRadius)
	local bestPlayer = nil
	local bestPos = nil
	local bestMetric = math.huge

	local function evaluatePlayer(player)
		if player == LocalPlayer or isSameTeam(player, AimbotConfig.TeamCheck) then return end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local anchor = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head"))
		if not (character and humanoid and anchor and humanoid.Health > 0) then return end

		local aimPos, aimPart = getAimTargetData(character, humanoid)
		if not (aimPos and aimPart) then return end

		local dist = (Camera.CFrame.Position - aimPos).Magnitude
		if dist > AimbotConfig.MaxDistance then return end
		if not hasLineOfSight(Camera.CFrame.Position, aimPart, character) then return end

		local screenPos, onScreen = Camera:WorldToViewportPoint(aimPos)
		if not onScreen then return end

		local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
		if AimbotConfig.FOVEnabled and screenDist > effectiveFOVRadius then return end

		local metric = (AimbotConfig.Priority == "Distancia") and dist or screenDist
		if metric < bestMetric then
			bestMetric = metric
			bestPlayer = player
			bestPos = aimPos
		end
	end

	if AimbotConfig.StickyTarget and currentLockedPlayer and currentLockedPlayer.Parent == Players then
		evaluatePlayer(currentLockedPlayer)
		if bestPlayer == currentLockedPlayer and bestPos then
			return bestPos, bestPlayer
		end
	end

	bestPlayer = nil
	bestPos = nil
	bestMetric = math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		evaluatePlayer(plr)
	end

	currentLockedPlayer = bestPlayer
	return bestPos, bestPlayer
end

