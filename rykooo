local function copyToClipboard(text)
	local ok = false
	pcall(function()
		if type(setclipboard) == "function" then
			setclipboard(tostring(text))
			ok = true
		elseif type(toclipboard) == "function" then
			toclipboard(tostring(text))
			ok = true
		end
	end)
	return ok
end

-- ==========================================
-- REDE, REGIÃO, FPS, MEMÓRIA E BOOST
-- ==========================================
local function getPingMs()
	local pingMs = 0
	pcall(function()
		local net = Stats and Stats:FindFirstChild("Network")
		local serverStats = net and net:FindFirstChild("ServerStatsItem")
		local dataPing = serverStats and serverStats:FindFirstChild("Data Ping")
		if dataPing and type(dataPing.GetValue) == "function" then
			pingMs = math.floor(dataPing:GetValue() + 0.5)
		end
	end)
	if pingMs <= 0 then
		pcall(function()
			if type(LocalPlayer.GetNetworkPing) == "function" then
				pingMs = math.floor((LocalPlayer:GetNetworkPing() * 1000) + 0.5)
			end
		end)
	end
	if pingMs < 0 then
		pingMs = 0
	end
	return pingMs
end

local function getMemoryMB()
	local mem = 0
	pcall(function()
		mem = math.floor(Stats:GetTotalMemoryUsageMb() + 0.5)
	end)
	return mem
end

local function detectServerRegion()
	local currentPing = getPingMs()
	local regionCode = nil
	pcall(function()
		local code = LocalizationService:GetCountryRegionForPlayerAsync(LocalPlayer)
		if type(code) == "string" and #code >= 2 then
			regionCode = string.upper(string.sub(code, 1, 2))
		end
	end)
	local estimated = false
	if not regionCode or not CountryFlags[regionCode] then
		estimated = true
		if currentPing > 0 and currentPing <= 55 then
			regionCode = "BR"
		elseif currentPing > 0 and currentPing <= 185 then
			regionCode = "US"
		elseif currentPing > 0 and currentPing <= 275 then
			regionCode = "DE"
		elseif currentPing > 275 then
			regionCode = "SG"
		else
			regionCode = "BR"
		end
	end
	local info = CountryFlags[regionCode] or { Name = regionCode, Flag = "🌍" }
	return {
		Code = regionCode,
		Name = info.Name,
		Flag = info.Flag,
		Ping = currentPing,
		Estimated = estimated,
	}
end

local SavedLighting = {
	GlobalShadows = Lighting.GlobalShadows,
	FogEnd = Lighting.FogEnd,
	FogStart = Lighting.FogStart,
	Brightness = Lighting.Brightness,
	Ambient = Lighting.Ambient,
	OutdoorAmbient = Lighting.OutdoorAmbient,
	ClockTime = Lighting.ClockTime,
}

local function applyShadowsState(disableShadows)
	pcall(function()
		Lighting.GlobalShadows = not disableShadows
	end)
	for _, obj in ipairs(workspace:GetDescendants()) do
		pcall(function()
			if obj:IsA("BasePart") then
				obj.CastShadow = not disableShadows
			end
		end)
	end
end

local function applyParticlesState(disableParticles)
	for _, obj in ipairs(workspace:GetDescendants()) do
		pcall(function()
			if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Beam") then
				obj.Enabled = not disableParticles
			end
		end)
	end
end

local function applyPlasticState(plastic)
	if not plastic then
		return
	end
	for _, obj in ipairs(workspace:GetDescendants()) do
		pcall(function()
			if obj:IsA("BasePart") then
				obj.Material = Enum.Material.Plastic
			end
		end)
	end
end

local function applyDecalsState(hideDecals)
	for _, obj in ipairs(workspace:GetDescendants()) do
		pcall(function()
			if obj:IsA("Decal") or obj:IsA("Texture") then
				obj.Transparency = hideDecals and 1 or 0
			end
		end)
	end
end

local function applyFPSBoost(enabled)
	FPSConfig.BoostEnabled = enabled
	pcall(function()
		settings().Rendering.QualityLevel = enabled and Enum.QualityLevel.Level01 or Enum.QualityLevel.Automatic
	end)
	if enabled then
		pcall(function()
			Lighting.GlobalShadows = false
			Lighting.FogEnd = 100000
		end)
		for _, v in ipairs(Lighting:GetChildren()) do
			pcall(function()
				if v:IsA("PostEffect") or v:IsA("Atmosphere") then
					v.Enabled = false
				end
			end)
		end
		applyShadowsState(true)
		applyParticlesState(true)
		applyPlasticState(true)
		applyDecalsState(true)
	else
		pcall(function()
			Lighting.GlobalShadows = SavedLighting.GlobalShadows
			Lighting.FogEnd = SavedLighting.FogEnd
			Lighting.Brightness = SavedLighting.Brightness
		end)
		for _, v in ipairs(Lighting:GetChildren()) do
			pcall(function()
				if v:IsA("PostEffect") or v:IsA("Atmosphere") then
					v.Enabled = true
				end
			end)
		end
		if not FPSConfig.NoShadows then
			applyShadowsState(false)
		end
		if not FPSConfig.NoParticles then
			applyParticlesState(false)
		end
		if not FPSConfig.NoDecals then
			applyDecalsState(false)
		end
	end
end

local function applyFPSCap(cap)
	pcall(function()
		if type(setfpscap) == "function" then
			setfpscap(cap)
		end
	end)
end

