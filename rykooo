ConfigTab:Button({
	Title = "Salvar Config",
	Desc = "Salva o estado atual com o nome digitado",
	Callback = function()
		local cfgName = sanitizeConfigName(selectedConfigName)
		if cfgName == "" then
			notifyHub("RYKO HUB | Config", "Digite um nome para salvar.")
			return
		end
		ensureConfigFolder()
		local path = CONFIG_FOLDER .. "/" .. cfgName .. ".json"
		local ok = pcall(function()
			writefile(path, HttpService:JSONEncode(exportAllSettings()))
		end)
		if ok then
			refreshConfigDropdown(cfgName)
			notifyHub("RYKO HUB | Config", "Config '" .. cfgName .. "' salva!")
		else
			notifyHub("RYKO HUB | Config", "Executor sem suporte a writefile.")
		end
	end,
})

ConfigTab:Button({
	Title = "Load Config",
	Desc = "Carrega a config selecionada/digitada",
	Callback = function()
		local cfgName = sanitizeConfigName(selectedConfigName)
		if cfgName == "" then
			notifyHub("RYKO HUB | Config", "Escolha ou digite o nome de uma config.")
			return
		end
		local path = CONFIG_FOLDER .. "/" .. cfgName .. ".json"
		local raw = nil
		local ok = pcall(function()
			if type(isfile) == "function" and isfile(path) then
				raw = readfile(path)
			elseif type(readfile) == "function" then
				raw = readfile(path)
			end
		end)
		if ok and type(raw) == "string" and raw ~= "" then
			local decOk, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
			if decOk and type(decoded) == "table" then
				applyAllSettings(decoded)
				notifyHub("RYKO HUB | Config", "Config '" .. cfgName .. "' carregada!")
				return
			end
		end
		notifyHub("RYKO HUB | Config", "Config '" .. cfgName .. "' não encontrada.")
	end,
})

ConfigTab:Button({
	Title = "Deletar Config",
	Desc = "Apaga a config selecionada/digitada",
	Callback = function()
		local cfgName = sanitizeConfigName(selectedConfigName)
		if cfgName == "" then
			notifyHub("RYKO HUB | Config", "Escolha ou digite o nome para deletar.")
			return
		end
		local path = CONFIG_FOLDER .. "/" .. cfgName .. ".json"
		local ok = pcall(function()
			if type(delfile) == "function" and (type(isfile) ~= "function" or isfile(path)) then
				delfile(path)
			end
		end)
		if ok then
			selectedConfigName = ""
			refreshConfigDropdown("")
			notifyHub("RYKO HUB | Config", "Config '" .. cfgName .. "' deletada!")
		else
			notifyHub("RYKO HUB | Config", "Não foi possível deletar a config.")
		end
	end,
})

