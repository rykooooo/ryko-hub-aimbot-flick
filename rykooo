local ConfigTab = Window:Tab({ Title = "Config", Icon = "save" })

local CONFIG_FOLDER = "RYKO_HUB_CONFIGS"
local selectedConfigName = ""

local function sanitizeConfigName(name)
	if type(name) ~= "string" then
		return ""
	end
	return name:gsub("^%s+", ""):gsub("%s+$", ""):gsub("[^%w_%-]", "_")
end

local function ensureConfigFolder()
	pcall(function()
		if type(makefolder) == "function" and (type(isfolder) ~= "function" or not isfolder(CONFIG_FOLDER)) then
			makefolder(CONFIG_FOLDER)
		end
	end)
end

local function getSavedConfigs()
	local list = {}
	ensureConfigFolder()
	pcall(function()
		if type(listfiles) == "function" then
			for _, path in ipairs(listfiles(CONFIG_FOLDER)) do
				local fileName = path:match("([^/\\]+)$") or path
				if fileName:sub(-5) == ".json" then
					local cfgName = fileName:sub(1, -6)
					if cfgName ~= "" then
						table.insert(list, cfgName)
					end
				end
			end
		end
	end)
	table.sort(list)
	return list
end

local function colorToTable(c)
	return {
		r = math.floor((c.R * 255) + 0.5),
		g = math.floor((c.G * 255) + 0.5),
		b = math.floor((c.B * 255) + 0.5),
	}
end

local function tableToColor(t, fallback)
	if type(t) == "table" and type(t.r) == "number" and type(t.g) == "number" and type(t.b) == "number" then
		return Color3.fromRGB(t.r, t.g, t.b)
	end
	return fallback
end

local function safeSet(el, method, val)
	if el and type(el[method]) == "function" then
		pcall(function()
			el[method](el, val)
		end)
	end
end

