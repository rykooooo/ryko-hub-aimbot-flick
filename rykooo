local function applyAllSettings(data)
	if type(data) ~= "table" then
		return
	end

	if type(data.Hub) == "table" and type(data.Hub.Notifications) == "boolean" then
		HubConfig.Notifications = data.Hub.Notifications
		safeSet(UIRefs.HubNotif, "Set", data.Hub.Notifications)
	end

	if type(data.ESP) == "table" then
		local e = data.ESP
		if type(e.MasterEnabled) == "boolean" then ESPConfig.MasterEnabled = e.MasterEnabled; safeSet(UIRefs.ESPMaster, "Set", e.MasterEnabled) end
		if type(e.OnlyAlive) == "boolean" then ESPConfig.OnlyAlive = e.OnlyAlive; safeSet(UIRefs.ESPOnlyAlive, "Set", e.OnlyAlive) end
		if type(e.Box2D) == "boolean" then ESPConfig.Box2D = e.Box2D; safeSet(UIRefs.ESPBox2D, "Set", e.Box2D) end
		if type(e.Box3D) == "boolean" then ESPConfig.Box3D = e.Box3D; safeSet(UIRefs.ESPBox3D, "Set", e.Box3D) end
		if type(e.CornerBox) == "boolean" then ESPConfig.CornerBox = e.CornerBox; safeSet(UIRefs.ESPCornerBox, "Set", e.CornerBox) end
		if type(e.Skeleton) == "boolean" then ESPConfig.Skeleton = e.Skeleton; safeSet(UIRefs.ESPSkeleton, "Set", e.Skeleton) end
		if type(e.LineEnabled) == "boolean" then ESPConfig.LineEnabled = e.LineEnabled; safeSet(UIRefs.LineEnabled, "Set", e.LineEnabled) end
		if e.LineOrigin == "Embaixo" or e.LineOrigin == "Em cima" then ESPConfig.LineOrigin = e.LineOrigin; safeSet(UIRefs.LineOrigin, "Select", e.LineOrigin) end
		ESPConfig.LineColor = tableToColor(e.LineColor, ESPConfig.LineColor); safeSet(UIRefs.LineColor, "Set", ESPConfig.LineColor)
		if type(e.HealthBar) == "boolean" then ESPConfig.HealthBar = e.HealthBar; safeSet(UIRefs.ESPHealthBar, "Set", e.HealthBar) end
		if type(e.HealthText) == "boolean" then ESPConfig.HealthText = e.HealthText; safeSet(UIRefs.ESPHealthText, "Set", e.HealthText) end
		if type(e.Name) == "boolean" then ESPConfig.Name = e.Name; safeSet(UIRefs.ESPName, "Set", e.Name) end
		if type(e.UseDisplayName) == "boolean" then ESPConfig.UseDisplayName = e.UseDisplayName; safeSet(UIRefs.ESPUseDisplay, "Set", e.UseDisplayName) end
		if type(e.Distance) == "boolean" then ESPConfig.Distance = e.Distance; safeSet(UIRefs.ESPDistance, "Set", e.Distance) end
		if type(e.Tool) == "boolean" then ESPConfig.Tool = e.Tool; safeSet(UIRefs.ESPTool, "Set", e.Tool) end
		if type(e.Highlight) == "boolean" then ESPConfig.Highlight = e.Highlight; safeSet(UIRefs.ESPHighlight, "Set", e.Highlight) end
		if type(e.TeamCheck) == "boolean" then ESPConfig.TeamCheck = e.TeamCheck; safeSet(UIRefs.ESPTeamCheck, "Set", e.TeamCheck) end
		if type(e.FriendHighlight) == "boolean" then ESPConfig.FriendHighlight = e.FriendHighlight; safeSet(UIRefs.ESPFriendHighlight, "Set", e.FriendHighlight) end
		ESPConfig.FriendColor = tableToColor(e.FriendColor, ESPConfig.FriendColor); safeSet(UIRefs.FriendColor, "Set", ESPConfig.FriendColor)
		if type(e.TargetIndicator) == "boolean" then ESPConfig.TargetIndicator = e.TargetIndicator; safeSet(UIRefs.ESPTargetInd, "Set", e.TargetIndicator) end
		ESPConfig.TargetColor = tableToColor(e.TargetColor, ESPConfig.TargetColor); safeSet(UIRefs.TargetColor, "Set", ESPConfig.TargetColor)
		if type(e.OutOfFOVArrows) == "boolean" then ESPConfig.OutOfFOVArrows = e.OutOfFOVArrows; safeSet(UIRefs.ESPArrows, "Set", e.OutOfFOVArrows) end
		if type(e.MaxDistance) == "number" then ESPConfig.MaxDistance = e.MaxDistance; safeSet(UIRefs.ESPMaxDist, "Set", e.MaxDistance) end
		if type(e.TextSize) == "number" then ESPConfig.TextSize = e.TextSize; safeSet(UIRefs.ESPTextSize, "Set", e.TextSize) end
		if type(e.Thickness) == "number" then ESPConfig.Thickness = e.Thickness; safeSet(UIRefs.ESPThickness, "Set", e.Thickness) end
		ESPConfig.Color = tableToColor(e.Color, ESPConfig.Color); safeSet(UIRefs.ESPColor, "Set", ESPConfig.Color)
	end

	if type(data.Aimbot) == "table" then
		local a = data.Aimbot
		if type(a.Enabled) == "boolean" then AimbotConfig.Enabled = a.Enabled; safeSet(UIRefs.AimbotEnabled, "Set", a.Enabled) end
		if type(a.TeamCheck) == "boolean" then AimbotConfig.TeamCheck = a.TeamCheck; safeSet(UIRefs.AimTeamCheck, "Set", a.TeamCheck) end
		if type(a.WallCheck) == "boolean" then AimbotConfig.WallCheck = a.WallCheck; safeSet(UIRefs.AimWallCheck, "Set", a.WallCheck) end
		if type(a.TargetSpot) == "string" then AimbotConfig.TargetSpot = a.TargetSpot; safeSet(UIRefs.AimSpot, "Select", a.TargetSpot) end
		if type(a.Smoothness) == "number" then
			local sm = math.clamp(a.Smoothness, 5, 100)
			AimbotConfig.Smoothness = sm / 100
			safeSet(UIRefs.AimSmooth, "Set", sm)
		end
		if type(a.MaxDistance) == "number" then AimbotConfig.MaxDistance = a.MaxDistance; safeSet(UIRefs.AimMaxDist, "Set", a.MaxDistance) end
		if type(a.Priority) == "string" then AimbotConfig.Priority = a.Priority; safeSet(UIRefs.AimPriority, "Select", a.Priority) end
		if type(a.Prediction) == "number" then
			local pred = math.clamp(a.Prediction, 0, 30)
			AimbotConfig.Prediction = pred / 100
			safeSet(UIRefs.AimPrediction, "Set", pred)
		end
		if type(a.StickyTarget) == "boolean" then AimbotConfig.StickyTarget = a.StickyTarget; safeSet(UIRefs.AimSticky, "Set", a.StickyTarget) end
		if type(a.FloatingButton) == "boolean" then AimbotConfig.FloatingButton = a.FloatingButton; AimBtn.Visible = a.FloatingButton; safeSet(UIRefs.AimFloatingBtn, "Set", a.FloatingButton) end
		if type(a.DisableOnTouch) == "boolean" then AimbotConfig.DisableOnTouch = a.DisableOnTouch; safeSet(UIRefs.AimDisableTouch, "Set", a.DisableOnTouch) end
		if type(a.FOVEnabled) == "boolean" then AimbotConfig.FOVEnabled = a.FOVEnabled; safeSet(UIRefs.FOVEnabled, "Set", a.FOVEnabled) end
		if type(a.FOVOnlyWhenAiming) == "boolean" then AimbotConfig.FOVOnlyWhenAiming = a.FOVOnlyWhenAiming; safeSet(UIRefs.FOVOnlyAim, "Set", a.FOVOnlyWhenAiming) end
		if type(a.FOVDynamicZoom) == "boolean" then AimbotConfig.FOVDynamicZoom = a.FOVDynamicZoom; safeSet(UIRefs.FOVZoom, "Set", a.FOVDynamicZoom) end
		if type(a.FOVRadius) == "number" then AimbotConfig.FOVRadius = a.FOVRadius; safeSet(UIRefs.FOVRadius, "Set", a.FOVRadius) end
		if type(a.FOVThickness) == "number" then AimbotConfig.FOVThickness = a.FOVThickness; safeSet(UIRefs.FOVThick, "Set", a.FOVThickness) end
		if type(a.FOVNumSides) == "number" then AimbotConfig.FOVNumSides = a.FOVNumSides; safeSet(UIRefs.FOVSides, "Set", a.FOVNumSides) end
		AimbotConfig.FOVColor = tableToColor(a.FOVColor, AimbotConfig.FOVColor); safeSet(UIRefs.FOVColor, "Set", AimbotConfig.FOVColor)
		syncAimbotButtonText()
	end

	if type(data.Move) == "table" then
		local m = data.Move
		if type(m.WalkSpeedEnabled) == "boolean" then MoveConfig.WalkSpeedEnabled = m.WalkSpeedEnabled; safeSet(UIRefs.WalkSpeedEn, "Set", m.WalkSpeedEnabled) end
		if type(m.WalkSpeed) == "number" then MoveConfig.WalkSpeed = m.WalkSpeed; safeSet(UIRefs.WalkSpeedVal, "Set", m.WalkSpeed) end
		if type(m.WalkSpeedLoop) == "boolean" then MoveConfig.WalkSpeedLoop = m.WalkSpeedLoop; safeSet(UIRefs.WalkSpeedLoop, "Set", m.WalkSpeedLoop) end
		if type(m.JumpPowerEnabled) == "boolean" then MoveConfig.JumpPowerEnabled = m.JumpPowerEnabled; safeSet(UIRefs.JumpPowerEn, "Set", m.JumpPowerEnabled) end
		if type(m.JumpPower) == "number" then MoveConfig.JumpPower = m.JumpPower; safeSet(UIRefs.JumpPowerVal, "Set", m.JumpPower) end
		if type(m.InfiniteJump) == "boolean" then MoveConfig.InfiniteJump = m.InfiniteJump; safeSet(UIRefs.InfJump, "Set", m.InfiniteJump) end
		if type(m.NoClip) == "boolean" then MoveConfig.NoClip = m.NoClip; safeSet(UIRefs.NoClip, "Set", m.NoClip) end
		if type(m.FlyEnabled) == "boolean" then MoveConfig.FlyEnabled = m.FlyEnabled; safeSet(UIRefs.FlyEn, "Set", m.FlyEnabled) end
		if type(m.FlySpeed) == "number" then MoveConfig.FlySpeed = m.FlySpeed; safeSet(UIRefs.FlySpeed, "Set", m.FlySpeed) end
		if type(m.AntiAFK) == "boolean" then MoveConfig.AntiAFK = m.AntiAFK; safeSet(UIRefs.AntiAFK, "Set", m.AntiAFK) end
		if type(m.AntiRagdoll) == "boolean" then MoveConfig.AntiRagdoll = m.AntiRagdoll; safeSet(UIRefs.AntiRagdoll, "Set", m.AntiRagdoll) end
		if type(m.Spinbot) == "boolean" then MoveConfig.Spinbot = m.Spinbot; safeSet(UIRefs.Spinbot, "Set", m.Spinbot) end
		if type(m.SpinSpeed) == "number" then MoveConfig.SpinSpeed = m.SpinSpeed; safeSet(UIRefs.SpinSpeed, "Set", m.SpinSpeed) end
		if type(m.CameraFOV) == "number" then MoveConfig.CameraFOV = m.CameraFOV; safeSet(UIRefs.CamFOV, "Set", m.CameraFOV); pcall(function() if workspace.CurrentCamera then workspace.CurrentCamera.FieldOfView = m.CameraFOV end end) end
		if type(m.Shiftlock) == "boolean" then MoveConfig.Shiftlock = m.Shiftlock; safeSet(UIRefs.Shiftlock, "Set", m.Shiftlock) end
		if type(m.AutoSprint) == "boolean" then MoveConfig.AutoSprint = m.AutoSprint; safeSet(UIRefs.AutoSprint, "Set", m.AutoSprint) end
		if type(m.Gravity) == "number" then MoveConfig.Gravity = m.Gravity; safeSet(UIRefs.Gravity, "Set", m.Gravity); pcall(function() workspace.Gravity = m.Gravity end) end
	end

	if type(data.FPS) == "table" then
		local f = data.FPS
		if type(f.NoShadows) == "boolean" then FPSConfig.NoShadows = f.NoShadows; safeSet(UIRefs.NoShadows, "Set", f.NoShadows); applyShadowsState(f.NoShadows) end
		if type(f.NoParticles) == "boolean" then FPSConfig.NoParticles = f.NoParticles; safeSet(UIRefs.NoParticles, "Set", f.NoParticles); applyParticlesState(f.NoParticles) end
		if type(f.PlasticMode) == "boolean" then FPSConfig.PlasticMode = f.PlasticMode; safeSet(UIRefs.PlasticMode, "Set", f.PlasticMode); applyPlasticState(f.PlasticMode) end
		if type(f.NoDecals) == "boolean" then FPSConfig.NoDecals = f.NoDecals; safeSet(UIRefs.NoDecals, "Set", f.NoDecals); applyDecalsState(f.NoDecals) end
		if type(f.BoostEnabled) == "boolean" then FPSConfig.BoostEnabled = f.BoostEnabled; safeSet(UIRefs.FPSBoost, "Set", f.BoostEnabled); applyFPSBoost(f.BoostEnabled) end
		if type(f.FPSCap) == "number" then FPSConfig.FPSCap = f.FPSCap; safeSet(UIRefs.FPSCap, "Set", f.FPSCap); applyFPSCap(f.FPSCap) end
		if type(f.ShowPing) == "boolean" then FPSConfig.ShowPing = f.ShowPing; safeSet(UIRefs.ShowPing, "Set", f.ShowPing) end
		if type(f.ShowMemory) == "boolean" then FPSConfig.ShowMemory = f.ShowMemory; safeSet(UIRefs.ShowMem, "Set", f.ShowMemory) end
		if type(f.DynamicColor) == "boolean" then FPSConfig.DynamicColor = f.DynamicColor; safeSet(UIRefs.DynamicFPSColor, "Set", f.DynamicColor) end
		if type(f.CompactCounter) == "boolean" then FPSConfig.CompactCounter = f.CompactCounter; safeSet(UIRefs.CompactCounter, "Set", f.CompactCounter) end
		if type(f.CounterVisible) == "boolean" then FPSConfig.CounterVisible = f.CounterVisible; FPSFrame.Visible = f.CounterVisible; safeSet(UIRefs.ShowCounter, "Set", f.CounterVisible) end
		updateFPSFrameLayout()
	end

	if type(data.World) == "table" then
		local w = data.World
		if type(w.Fullbright) == "boolean" then WorldConfig.Fullbright = w.Fullbright; safeSet(UIRefs.Fullbright, "Set", w.Fullbright) end
		if type(w.NoFog) == "boolean" then WorldConfig.NoFog = w.NoFog; safeSet(UIRefs.NoFog, "Set", w.NoFog) end
		if type(w.MuteAudio) == "boolean" then WorldConfig.MuteAudio = w.MuteAudio; safeSet(UIRefs.MuteAudio, "Set", w.MuteAudio); pcall(function() SoundService.Volume = w.MuteAudio and 0 or 1 end) end
		if type(w.AutoSkipPopups) == "boolean" then WorldConfig.AutoSkipPopups = w.AutoSkipPopups; safeSet(UIRefs.AutoSkipPopups, "Set", w.AutoSkipPopups) end
	end
end

